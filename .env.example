# Copy this file to `.env` in the repo root and fill it in before `docker compose up`.
# `docker compose` reads `.env` automatically for the ${VAR:-default} substitutions in
# docker-compose.yml. NEVER put a real secret in this file (.env.example) — it's tracked
# in git. Put real values only in your own git-ignored `.env`.
#
# --- First run --------------------------------------------------------------------
# SECY_AUTH_REGISTRATION_ENABLED defaults to true below, and the FIRST account created via
# the UI's register screen (or `POST /auth/register`) becomes ADMIN. Register your admin
# account immediately after `docker compose up`, then set SECY_AUTH_REGISTRATION_ENABLED=false
# and restart the `api` service to lock further self-registration.

# --- Database ------------------------------------------------------------------------
# Connection the `api` service uses. The default points at the bundled `postgres` compose
# service by its internal Docker DNS name/port (5432 — not published to the host; see
# docker-compose.yml). Only change SECY_DB_URL if you're pointing at an external Postgres.
SECY_DB_URL=jdbc:postgresql://postgres:5432/secy
SECY_DB_USERNAME=secy
# Also becomes the bundled Postgres container's superuser password (POSTGRES_PASSWORD).
# The "secy" default is fine for a one-off local demo; change it for anything you keep
# running or expose beyond localhost.
SECY_DB_PASSWORD=secy

# --- Auth ------------------------------------------------------------------------------
# HS256 JWT signing key, >= 32 characters. Generate one with: openssl rand -base64 48
# Leave blank and the API generates a random throwaway secret on every process start —
# fine for a quick demo, but it means every issued JWT (every logged-in session) is
# invalidated on each container restart. Set a real value for anything persistent.
SECY_AUTH_JWT_SECRET=
# See "First run" above.
SECY_AUTH_REGISTRATION_ENABLED=true

# --- NVD feed ----------------------------------------------------------------------------
# Request a free key at https://nvd.nist.gov/developers/request-an-api-key . Ingestion
# works without one but is rate-limited much lower (5 req/30s vs. 50 req/30s with a key).
NVD_API_KEY=

# --- Actionable funnel -----------------------------------------------------------------
# An alert is promoted to actionable when its CVE is KEV-listed OR its EPSS probability is
# STRICTLY greater than this value. Raise it to cut noise, lower it to widen the net.
SECY_ACTIONABLE_EPSS_THRESHOLD=0.1

# --- OSV mirror --------------------------------------------------------------------------
# Comma-separated OSV ecosystem names to mirror into osv_advisory (see
# https://ossf.github.io/osv-schema/#affectedpackage-field for the full ecosystem list).
# The default covers every ecosystem the correlation engine's VersionScheme understands.
SECY_OSV_ECOSYSTEMS=npm,Maven,PyPI,Go,NuGet,RubyGems,crates.io,Packagist,Hex,Pub

# --- CVE List v5 / Vulnrichment feed -----------------------------------------------------
# GitHub releases API URL polled for the latest CVEProject/cvelistV5 bulk export (the CVE
# JSON 5.1 records + CISA-ADP Vulnrichment container). Only change this if you mirror the
# feed yourself.
SECY_CVE_LIST_RELEASES_API_URL=https://api.github.com/repos/CVEProject/cvelistV5/releases/latest
